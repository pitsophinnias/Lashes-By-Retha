DATABASE_URL=postgresql://hbh_admin:hbh_password@localhost:5432/hairbyher
PORT=3002
NODE_ENV=development
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
# Comma-separated list of frontend origins allowed to call this API in production
ALLOWED_ORIGINS=https://www.hairbyher.co.za,https://hairbyher.co.za,https://admin.hairbyher.co.za
SETMORE_REFRESH_TOKEN=
# From your Cloudinary dashboard (Account Details). Leave unset for local dev
# to keep using local disk storage under backend/uploads.
CLOUDINARY_URL=cloudinary://replace-with-your-api-key:replace-with-your-api-secret@replace-with-your-cloud-name
