DATABASE_URL=postgresql://hbh_admin:hbh_password@localhost:5432/hairbyher
PORT=3002
NODE_ENV=development
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
# Comma-separated list of frontend origins allowed to call this API in production
ALLOWED_ORIGINS=https://www.hairbyher.co.za,https://hairbyher.co.za,https://admin.hairbyher.co.za
SETMORE_REFRESH_TOKEN=
# From your Cloudinary dashboard (Account Details). Leave unset for local dev
# to keep using local disk storage under backend/uploads.
CLOUDINARY_URL=cloudinary://replace-with-your-api-key:replace-with-your-api-secret@replace-with-your-cloud-name
# Ozow pay-by-bank. From the Ozow dashboard's Sites tab (OZOW_SITE_CODE, OZOW_PRIVATE_KEY)
# and Merchant Details tab (OZOW_API_KEY). Leave any of these unset, along with
# PUBLIC_API_URL/CUSTOMER_SITE_URL below, and checkout only offers EFT.
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
# true or false - defaults to true (test mode) when unset, so nothing goes live by accident.
OZOW_IS_TEST=true
OZOW_API_BASE=https://api.ozow.com
# Test (IsTest=true) transactions are only queryable on Ozow's staging API,
# not the live one - used to check the status of a test payment.
OZOW_TEST_API_BASE=https://stagingapi.ozow.com
# This backend's own public https URL, no trailing slash - used to build the
# Ozow return and notify URLs Ozow calls back to.
PUBLIC_API_URL=https://api.hairbyher.co.za
# The customer site's public URL, no trailing slash - used to redirect the
# customer back after paying with Ozow.
CUSTOMER_SITE_URL=https://www.hairbyher.co.za
