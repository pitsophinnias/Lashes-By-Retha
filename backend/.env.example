DATABASE_URL=postgresql://hbh_admin:hbh_password@localhost:5432/hairbyher
# A separate local database the test suite runs against - never the one
# above. Must be on localhost/127.0.0.1 and its name must end in "_test";
# npm test refuses to run otherwise. Create it once with:
#   psql -U postgres -c "CREATE DATABASE hairbyher_test OWNER hbh_admin;"
TEST_DATABASE_URL=postgresql://hbh_admin:hbh_password@localhost:5432/hairbyher_test
PORT=3002
# Which interface the server binds to. Defaults to 0.0.0.0 (all interfaces),
# fine for local dev. In production behind Nginx, set this to 127.0.0.1 so
# the API is only reachable through the reverse proxy, never directly.
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
# Admin session security - idle timeout, its advance warning, and the
# absolute max session length, all enforced server-side (see src/sessions).
# Defaults shown; see the README's "Admin session security" section,
# including how to shorten these for testing.
ADMIN_IDLE_TIMEOUT_MINUTES=5
ADMIN_IDLE_WARNING_SECONDS=60
ADMIN_MAX_SESSION_HOURS=12
ADMIN_SESSION_GRACE_SECONDS=30
# Comma-separated list of frontend origins allowed to call this API in production
ALLOWED_ORIGINS=https://www.hairbyher.co.za,https://hairbyher.co.za,https://admin.hairbyher.co.za
SETMORE_REFRESH_TOKEN=
# Where uploaded images/videos are stored on disk. Leave unset for local
# dev (defaults to backend/uploads). On the server, point this outside the
# repo, e.g. /home/serverha/hbh-uploads, so git pulls never touch it.
UPLOAD_DIR=
# Max upload size in MB - images default to 10MB, videos to 100MB if unset.
MAX_FILE_SIZE_MB=
MAX_VIDEO_FILE_SIZE_MB=
# Ozow pay-by-bank. From the Ozow dashboard's Sites tab (OZOW_SITE_CODE, OZOW_PRIVATE_KEY)
# and Merchant Details tab (OZOW_API_KEY). Leave any of these unset, along with
# PUBLIC_API_URL/CUSTOMER_SITE_URL below, and the Ozow option is hidden at checkout.
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
# true or false - defaults to true (test mode) when unset, so nothing goes live by accident.
OZOW_IS_TEST=true
OZOW_API_BASE=https://api.ozow.com
# Test (IsTest=true) transactions are only queryable on Ozow's staging API,
# not the live one - used to check the status of a test payment.
OZOW_TEST_API_BASE=https://stagingapi.ozow.com
# This backend's own public https URL, no trailing slash - used to build the
# Ozow and Payflex return/callback URLs they call back to.
PUBLIC_API_URL=https://api.hairbyher.co.za
# The customer site's public URL, no trailing slash - used to redirect the
# customer back after paying with Ozow or Payflex.
CUSTOMER_SITE_URL=https://www.hairbyher.co.za
# Payflex buy-now-pay-later. Client ID/Secret are issued by the Payflex
# Integrations Team. Leave any of these unset, along with PUBLIC_API_URL/
# CUSTOMER_SITE_URL above, and the Payflex option is hidden at checkout.
PAYFLEX_CLIENT_ID=
PAYFLEX_CLIENT_SECRET=
# Sandbox (UAT) values - switch to the production values when going live.
PAYFLEX_API_URL=https://api.uat.payflex.co.za
PAYFLEX_AUTH_URL=https://auth-uat.payflex.co.za/auth/merchant
PAYFLEX_AUDIENCE=https://auth-dev.payflex.co.za
# Shared secret backend/scripts/backup.sh sends as a Bearer token when it
# reports each backup run to POST /api/system/backups/report. Leave unset
# to disable that endpoint entirely - generate a long random string once
# you're ready to wire up backups on the server that hosts the database.
BACKUP_REPORT_TOKEN=
# Rate limits - see README's "Rate limiting" section for what each tier
# covers. All optional; defaults shown are sensible for production.
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_LOGIN_USERNAME_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_ORDER_IP_MAX=100
RATE_LIMIT_ORDER_IP_WINDOW_MS=900000
RATE_LIMIT_ORDER_PHONE_MAX=10
RATE_LIMIT_ORDER_PHONE_WINDOW_MS=3600000
RATE_LIMIT_PAYMENT_IP_MAX=100
RATE_LIMIT_PAYMENT_IP_WINDOW_MS=900000
RATE_LIMIT_PAYMENT_KEY_MAX=10
RATE_LIMIT_PAYMENT_KEY_WINDOW_MS=3600000
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
# Hostname the sysadmin Security page checks for SSL certificate expiry.
# Defaults to hairbyher.co.za.
SSL_CHECK_HOST=hairbyher.co.za
